# =============================================================================
# quantumco — variáveis de ambiente
# Copie para `.env` na raiz do repositório:  cp .env.example .env
# O backend lê o `.env` sozinho; variáveis já definidas no ambiente têm prioridade.
# Nunca faça commit do `.env`.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. JÁ USADAS PELO CÓDIGO (passo 1: Rede Viária + frontend)
# -----------------------------------------------------------------------------

# Backend — caminhos relativos são resolvidos a partir da pasta backend/
QC_METHODOLOGY_DIR=methodology/v1
QC_LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# Overpass (fonte do OSM). O público tem limite de uso; em produção dá para trocar por
# uma instância própria ou por um mirror (ex.: https://overpass.private.coffee/api/interpreter)
QC_OVERPASS_URL=https://overpass-api.de/api/interpreter
QC_OVERPASS_TIMEOUT_S=300

# Banco onde a rede e a análise são publicadas e de onde a API serve.
# Obrigatório: rede e análise ficam só aqui. Na VPS use o host interno do serviço.
QC_DATABASE_URL=postgresql+psycopg://quantumco:troque-isto@postgis:5432/quantumco

# Cookie de sessão só por HTTPS (deixe true em produção; false só para http://localhost)
QC_COOKIE_SECURE=true

# API: origens liberadas no CORS (vírgula). Vazio = só mesma origem
QC_CORS_ORIGINS=https://quantumco.exemplo.com.br

# Frontend (Vite só expõe ao navegador variáveis com prefixo VITE_; são lidas no BUILD)
# Mapa de fundo: vazio = estilo escuro da marca (OpenFreeMap). Uma URL de estilo MapLibre substitui
VITE_BASEMAP_STYLE_URL=
# URL da API. Vazio = mesma origem (dev: proxy do Vite; produção: proxy do Caddy)
VITE_API_URL=


# E-mail via Resend (API HTTP, sem SMTP) — confirmação de cadastro, recuperação de senha (Q48)
# Sem RESEND_API_KEY os e-mails só aparecem no log (modo dev).
RESEND_API_KEY=
MAIL_FROM=noreply@quantumco.com.br
MAIL_FROM_NAME="quantumco · Sintaxe Espacial de Brusque"
OWNER_EMAIL=                   # dono/admin: recebe avisos e testes

# -----------------------------------------------------------------------------
# 2. INFRA DA VPS — AINDA NÃO LIDAS PELO CÓDIGO
#    Já dá para criar os serviços no Easypanel com estes valores.
#    O passo em que cada grupo entra está indicado (ver docs/decisions.md).
# -----------------------------------------------------------------------------

# Geral
TZ=America/Sao_Paulo
QC_PUBLIC_BASE_URL=https://quantumco.com.br     # base dos links nos e-mails (confirmar e-mail, senha nova)
#   Em dev não precisa mudar: pedidos vindos de http://localhost:* usam a origem local nos links.

# PostGIS: criado pelo Easypanel (imagem postgis/postgis:18-3.6); a conexão é a QC_DATABASE_URL acima

# Redis — fila RQ dos cenários (já usada). Ligar AOF com volume persistente:
#   redis-server --appendonly yes
# (se o Redis perder a fila, o worker devolve à fila os pedidos "na fila" do banco ao subir)
QC_REDIS_URL=redis://redis:6379/0

# RustFS (S3) — arquivos imutáveis das releases (passo 3; Q33)
QC_S3_ENDPOINT=http://rustfs:9000
QC_S3_REGION=us-east-1
QC_S3_ACCESS_KEY=troque-isto
QC_S3_SECRET_KEY=troque-isto
QC_S3_BUCKET_RELEASES=quantumco-releases
QC_S3_BUCKET_AVATARS=quantumco-avatars          # fotos de perfil (privado; criado no primeiro envio)

# Motores de análise (passo 2; Q43, Q47)
QC_DEPTHMAPX_BIN=/opt/depthmapx/depthmapXcli    # binário v0.9.1 fixado por hash na imagem
RAYON_NUM_THREADS=2                              # threads do cityseer (KVM 2 = 2 vCPU)

# Cenários: fila de cálculo (Redis + RQ) e limites (Q45). Já lidas pelo código.
QC_SCENARIO_DAILY_QUOTA=10          # cálculos por usuário em 24 h (o OWNER_EMAIL não tem limite)
QC_SCENARIO_QUEUE_MAX=20            # pedidos na fila, de todos
QC_SCENARIO_ACTIVE_PER_USER=2       # na fila ou processando, por usuário
QC_SCENARIO_TIMEOUT_S=3600          # tempo máximo de um cálculo (o motor leva ~7 min sozinho)
QC_WORKERS=2                        # processos do worker em paralelo (2 vCPU: 2 já ocupam tudo)
QC_ROLE=api                         # no serviço do worker: QC_ROLE=worker (mesma build do backend)
# Dev: destino do /api no Vite (padrão http://127.0.0.1:8000)
# QC_API_PROXY=http://127.0.0.1:8001

# Identidade (passo 6; Q37, Q48)
QC_SESSION_SECRET=gere-com-openssl-rand-hex-32
VITE_TURNSTILE_SITE_KEY=                         # Cloudflare Turnstile: chave pública (vai para o navegador)
QC_TURNSTILE_SECRET_KEY=                         # chave secreta: só no backend, nunca no frontend
