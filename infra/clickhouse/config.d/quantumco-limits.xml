<!-- ClickHouse na mesma VPS do PostGIS e da API (docs/adr/0001): limites do servidor.
     Montado no Easypanel em /etc/clickhouse-server/config.d/quantumco-limits.xml.
     O contêiner tem limite de 3 GB; o servidor para em 2,5 GB e devolve erro em vez de ser morto. -->
<clickhouse>
    <max_server_memory_usage>2684354560</max_server_memory_usage>
    <max_concurrent_queries>20</max_concurrent_queries>
    <mark_cache_size>268435456</mark_cache_size>
    <background_pool_size>2</background_pool_size>
</clickhouse>
