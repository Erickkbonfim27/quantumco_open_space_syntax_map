<!-- Limites por consulta (perfil padrão, usado pelo usuário da aplicação).
     Montado no Easypanel em /etc/clickhouse-server/users.d/quantumco-profile.xml.
     Acima de 1 GB, GROUP BY e ORDER BY vão para o disco em vez de estourar a memória. -->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>2000000000</max_memory_usage>
            <max_threads>2</max_threads>
            <max_bytes_before_external_group_by>1000000000</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>1000000000</max_bytes_before_external_sort>
        </default>
    </profiles>
</clickhouse>
