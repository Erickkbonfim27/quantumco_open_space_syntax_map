# O Easypanel termina o HTTPS na frente; aqui é HTTP simples na porta 80.
# API_UPSTREAM = endereço interno do serviço da API no Easypanel (ex.: space-syntax_api:8000).
:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	handle /health {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	handle {
		root * /srv/site
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
